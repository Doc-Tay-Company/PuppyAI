# Puppy AI configuration
# Use these as environment variables (or matching -D system properties).
# Puppy does not parse a .env file automatically. Nothing here is required for
# the desktop shell or the mascot.

# --- Cloud AI (added in milestone 4) ---
# Provider key and model for the online AI mode.
PUPPY_CLOUD_API_KEY=
PUPPY_CLOUD_MODEL=

# --- Ollama (local AI) ---
# Base URL of the local Ollama server and the model used for chat.
# Qwen3.5 9B, as installed on this machine:
PUPPY_OLLAMA_URL=http://localhost:11434
PUPPY_OLLAMA_MODEL=hf.co/unsloth/Qwen3.5-9B-GGUF:Q4_K_M

# --- Tavily web search (added in milestone 5) ---
PUPPY_TAVILY_API_KEY=

# --- Desktop behaviour ---
# Keep the mascot above other windows (true/false).
PUPPY_ALWAYS_ON_TOP=true
