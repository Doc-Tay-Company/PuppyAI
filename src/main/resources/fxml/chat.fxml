<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.puppy.controller.ChatController"
      styleClass="panel-card" spacing="10" minWidth="0" minHeight="0">
    <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="8">
        <ImageView fx:id="chatMascotView" fitWidth="28" fitHeight="28"
                   preserveRatio="true" smooth="false"/>
        <Label text="Chat" styleClass="panel-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Menu" onAction="#onMainMenu" styleClass="quiet-button"/>
        <Button text="History" onAction="#toggleHistory" styleClass="quiet-button"/>
        <Button text="New" onAction="#newConversation" styleClass="quiet-button"/>
        <Button fx:id="expandButton" text="Expand" onAction="#toggleExpanded"
                styleClass="quiet-button"/>
        <Button text="_" onAction="#onMinimize" styleClass="window-button"/>
        <Button text="X" onAction="#onClose" styleClass="window-button"/>
    </HBox>
    <HBox spacing="10" VBox.vgrow="ALWAYS" minHeight="0">
        <VBox fx:id="historyPane" styleClass="history-pane" spacing="6"
              visible="false" managed="false" prefWidth="190" minWidth="170">
            <Label text="Sessions" styleClass="section-title"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="history-scroll"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="historyItems" spacing="4"/>
                </content>
            </ScrollPane>
        </VBox>
        <BorderPane styleClass="chat-body" HBox.hgrow="ALWAYS" minWidth="0">
            <center>
                <VBox spacing="4">
                    <ScrollPane fx:id="messageScroll" fitToWidth="true" hbarPolicy="NEVER"
                                styleClass="message-scroll" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="messagesBox" styleClass="messages-box" spacing="8"/>
                        </content>
                    </ScrollPane>
                    <Label fx:id="thinkingLabel" text="Puppy is thinking..."
                           styleClass="muted-copy, thinking-label"
                           visible="false" managed="false"/>
                </VBox>
            </center>
            <bottom>
                <VBox spacing="6">
                    <FlowPane fx:id="attachmentBar" hgap="6" vgap="4"
                              styleClass="attachment-bar"
                              visible="false" managed="false"/>
                    <Label fx:id="attachmentStatus" styleClass="muted-copy"
                           wrapText="true" visible="false" managed="false"/>
                    <HBox styleClass="composer" spacing="8">
                        <Button fx:id="attachButton" text="Attach" onAction="#attachDocument"
                                styleClass="quiet-button"/>
                        <TextField fx:id="messageInput"
                                   promptText="Ask anything, attach a file, type /focus or /model..."
                                   onAction="#sendMessage" HBox.hgrow="ALWAYS"/>
                        <Button text="Send" onAction="#sendMessage" fx:id="sendButton"
                                styleClass="primary-button"/>
                    </HBox>
                </VBox>
            </bottom>
        </BorderPane>
    </HBox>
</VBox>
