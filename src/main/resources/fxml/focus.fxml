<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="focusRoot" fx:controller="com.puppy.controller.FocusController"
      styleClass="panel-card, focus-panel" spacing="8" minWidth="0" minHeight="0">
    <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="8">
        <Label text="Focus Planner" styleClass="panel-title"/>
        <Label text="plan around school, deadlines and free time" styleClass="muted-copy"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Menu" onAction="#onMainMenu" styleClass="quiet-button"/>
        <Button text="_" onAction="#onMinimize" styleClass="window-button"/>
        <Button text="X" onAction="#onClose" styleClass="window-button"/>
    </HBox>

    <HBox spacing="10" VBox.vgrow="ALWAYS" minHeight="0">
        <VBox styleClass="focus-sidebar" spacing="8" prefWidth="330" minWidth="280">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Free time" styleClass="section-title"/>
                <ComboBox fx:id="availableFrom" prefWidth="88"/>
                <Label text="to"/>
                <ComboBox fx:id="availableTo" prefWidth="88"/>
                <Button text="Apply" onAction="#onApplyAvailability" styleClass="quiet-button"/>
            </HBox>
            <Label fx:id="availabilityStatus" styleClass="muted-copy" wrapText="true"/>

            <TabPane fx:id="plannerTabs" styleClass="focus-tabs" tabClosingPolicy="UNAVAILABLE"
                     VBox.vgrow="ALWAYS">
                <tabs>
                    <Tab text="Import">
                        <VBox styleClass="focus-tab-content" spacing="8">
                            <Label text="Attach your timetable, subject list or assignment sheet. Puppy asks the local model to read it, then fits sessions around your classes."
                                   styleClass="muted-copy" wrapText="true"/>
                            <Button fx:id="importButton" text="Choose files..."
                                    onAction="#onImportFiles" styleClass="primary-button"
                                    maxWidth="Infinity"/>
                            <Label text="PDF, DOCX, DOC, TXT or MD. Up to 5 files, 20 MB each."
                                   styleClass="muted-copy" wrapText="true"/>
                            <Label fx:id="importStatus" styleClass="muted-copy" wrapText="true"/>
                            <Button fx:id="generatePlanButton" text="Generate plan"
                                    onAction="#onGeneratePlan" styleClass="quiet-button"
                                    maxWidth="Infinity"/>
                            <Label text="Importing replaces nothing: classes and tasks you add by hand are kept."
                                   styleClass="muted-copy" wrapText="true"/>
                        </VBox>
                    </Tab>

                    <Tab text="Classes">
                        <VBox styleClass="focus-tab-content" spacing="6">
                            <Label text="Add each weekly class. Focus sessions never overlap these times."
                                   styleClass="muted-copy" wrapText="true"/>
                            <TextField fx:id="classSubject" promptText="Subject"/>
                            <HBox spacing="6">
                                <ComboBox fx:id="classDay" promptText="Weekday" HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="classStart" promptText="Start 08:00" prefWidth="100"/>
                                <TextField fx:id="classEnd" promptText="End 09:30" prefWidth="100"/>
                            </HBox>
                            <Button text="Add class" onAction="#onAddClass"
                                    styleClass="quiet-button" maxWidth="Infinity"/>
                            <ScrollPane fx:id="classScroll" fitToWidth="true" hbarPolicy="NEVER"
                                        styleClass="focus-list-scroll" VBox.vgrow="ALWAYS">
                                <content>
                                    <VBox fx:id="classList" spacing="4"/>
                                </content>
                            </ScrollPane>
                        </VBox>
                    </Tab>

                    <Tab text="Tasks">
                        <VBox styleClass="focus-tab-content" spacing="6">
                            <Label text="Quick focus covers review and reading. Deep focus covers programming, assignments and research."
                                   styleClass="muted-copy" wrapText="true"/>
                            <TextField fx:id="taskSubject" promptText="Subject"/>
                            <TextField fx:id="taskTitle" promptText="Task or assignment"/>
                            <ComboBox fx:id="taskType" maxWidth="Infinity"/>
                            <HBox spacing="6">
                                <TextField fx:id="taskMinutes" promptText="Minutes, e.g. 90"
                                           prefWidth="130"/>
                                <DatePicker fx:id="taskDeadline" promptText="Deadline"
                                            HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Button text="Add task" onAction="#onAddTask"
                                    styleClass="quiet-button" maxWidth="Infinity"/>
                            <ScrollPane fx:id="taskScroll" fitToWidth="true" hbarPolicy="NEVER"
                                        styleClass="focus-list-scroll" VBox.vgrow="ALWAYS">
                                <content>
                                    <VBox fx:id="taskList" spacing="4"/>
                                </content>
                            </ScrollPane>
                        </VBox>
                    </Tab>

                    <Tab fx:id="sessionTab" text="Session">
                        <VBox styleClass="focus-tab-content" spacing="6">
                            <Label fx:id="sessionFormHint"
                                   text="Create a one-off session directly in the planner."
                                   styleClass="muted-copy" wrapText="true"/>
                            <TextField fx:id="sessionSubject" promptText="Subject"/>
                            <TextField fx:id="sessionTitle" promptText="What will you do?"/>
                            <ComboBox fx:id="sessionType" maxWidth="Infinity"/>
                            <HBox spacing="6">
                                <DatePicker fx:id="sessionDate" HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="sessionStart" promptText="18:00" prefWidth="90"/>
                                <TextField fx:id="sessionMinutes" promptText="50" prefWidth="70"/>
                            </HBox>
                            <Button fx:id="sessionSaveButton" text="Add session"
                                    onAction="#onSaveSession" styleClass="primary-button"
                                    maxWidth="Infinity"/>
                            <Button fx:id="cancelEditButton" text="Cancel edit"
                                    onAction="#onCancelEdit" styleClass="quiet-button"
                                    maxWidth="Infinity" visible="false" managed="false"/>
                            <Label fx:id="sessionStatus" styleClass="muted-copy" wrapText="true"/>
                            <Label text="A manual or edited session still has to fit inside free time and must not overlap a class or another session."
                                   styleClass="muted-copy" wrapText="true"/>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>
            <Label fx:id="plannerStatus" styleClass="muted-copy" wrapText="true"/>
        </VBox>

        <VBox spacing="8" HBox.hgrow="ALWAYS" minWidth="0">
            <VBox styleClass="focus-timer-card" spacing="6">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <VBox spacing="1">
                        <Label fx:id="timerTitle" text="No session running" styleClass="section-title"/>
                        <Label fx:id="timerMeta" text="Pick a session on the right and press Start."
                               styleClass="muted-copy" wrapText="true"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="timerTime" text="--:--" styleClass="focus-timer-text"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="timerToggle" text="Start" onAction="#onToggleSessionTimer"
                            styleClass="primary-button" disable="true"/>
                    <Button fx:id="timerFinish" text="Finish" onAction="#onFinishSession"
                            styleClass="quiet-button" disable="true"/>
                    <Label fx:id="timerHint" styleClass="muted-copy" wrapText="true"/>
                </HBox>
            </VBox>

            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Sessions" styleClass="section-title"/>
                <Label fx:id="sessionCount" text="0 sessions" styleClass="muted-copy"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="clearPlanButton" text="Clear plan" onAction="#onClearPlan"
                        styleClass="quiet-button"/>
            </HBox>

            <ScrollPane fx:id="sessionsScroll" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="focus-sessions-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="sessionsBox" spacing="6"/>
                </content>
            </ScrollPane>

            <Label fx:id="planSummary" styleClass="muted-copy" wrapText="true"/>
            <Label fx:id="warningsLabel" styleClass="focus-warning" wrapText="true"
                   visible="false" managed="false"/>
        </VBox>
    </HBox>
</VBox>
