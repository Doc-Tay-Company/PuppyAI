<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.puppy.controller.MascotController" fx:id="shellRoot"
           styleClass="shell-root" prefWidth="336" prefHeight="252">
    <StackPane fx:id="mascotDock" styleClass="mascot-dock" prefHeight="210"
               minHeight="168" maxHeight="210" alignment="CENTER"
               StackPane.alignment="BOTTOM_CENTER">
        <ImageView fx:id="mascotView" styleClass="mascot-view"
                   fitWidth="286" fitHeight="190" preserveRatio="true" smooth="false"
                   StackPane.alignment="CENTER"/>
        <Label fx:id="mascotBubble" text="" styleClass="mascot-bubble"
               wrapText="true" maxWidth="286" visible="false" managed="false"
               StackPane.alignment="TOP_CENTER"/>
    </StackPane>
    <StackPane fx:id="menuHost" styleClass="menu-host" visible="false" managed="false"
               style="-fx-background-color: transparent;"
               StackPane.alignment="TOP_CENTER">
        <HBox fx:id="mainMenu" styleClass="main-menu" spacing="4">
            <Button text="Study" onAction="#openStudy" styleClass="menu-button"/>
            <Button text="Focus" onAction="#openFocus" styleClass="menu-button"/>
            <Button text="Chat" onAction="#openChat" styleClass="menu-button"/>
            <Button text="More" onAction="#openMore" styleClass="menu-button"/>
        </HBox>
    </StackPane>
</StackPane>
